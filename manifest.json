{
  "manifest_version": 3,
  "name": "PoE2 MTX Marker",
  "version": "0.1.1",
  "description": "Markiert Shop-Karten auf pathofexile.com, deren MTX laut poe2db.tw in Path of Exile 2 verfügbar sind.",
  "icons": {
    "16": "icons/icon-small.svg",
    "32": "icons/icon-small.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "poe2-mtx-marker@djih",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.pathofexile.com/*", "https://poe2db.tw/*"],
  "background": {
    "scripts": ["lib/core.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.pathofexile.com/shop*"],
      "js": ["lib/core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "action": {
    "default_title": "PoE2 MTX Marker",
    "default_icon": {
      "16": "icons/icon-small.svg",
      "32": "icons/icon-small.svg"
    },
    "default_popup": "popup.html"
  }
}
